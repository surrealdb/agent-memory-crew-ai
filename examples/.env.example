# Spectron credentials (the API key is a secret; keep this file out of git).
SPECTRON_ENDPOINT=https://your-instance.spectron.dev
SPECTRON_CONTEXT=my-context
SPECTRON_API_KEY=

# Optional
SPECTRON_DEFAULT_SCOPE=user/tobie
SPECTRON_TOP_K=5

# An LLM for CrewAI (needed only for live_crew.py).
OPENAI_API_KEY=
